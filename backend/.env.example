# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env — it's already in .gitignore. Only this .example
# file (with no real secrets) should ever be committed.

PORT=5000

# A long random string that protects the /api/admin/* routes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_KEY=

# From your Razorpay Dashboard → Settings → API Keys.
# Test mode keys start with rzp_test_ — use these until Step 3 of
# GO_LIVE_CHECKLIST.md (real hotel data) is done. Never put live
# (rzp_live_) keys here until then.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# From Razorpay Dashboard → Settings → Webhooks, when you add the webhook
# URL (see GO_LIVE_CHECKLIST.md). This is a DIFFERENT secret from
# RAZORPAY_KEY_SECRET above — don't mix them up.
RAZORPAY_WEBHOOK_SECRET=
